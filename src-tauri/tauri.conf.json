{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EndfieldModManager",
  "version": "0.1.0",
  "identifier": "com.carrotluo.endfield-mod-manager",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm.cmd run build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Endfield Mod Manager",
        "width": 1480,
        "height": 880,
        "minWidth": 1060,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "compression": "lzma"
      }
    }
  }
}
